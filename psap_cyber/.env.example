# copy to repo root .env or merge with your existing keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# use a dedicated index for psap corpus (do not share with review bot index)
PINECONE_API_KEY=
PINECONE_INDEX_PSAP=psap-cyber-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
